# Database (PostgreSQL)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"
# If your DATABASE_URL points at a connection pooler (e.g. Supabase's pgbouncer/session
# pooler port 6543), set DIRECT_URL to the non-pooled connection (port 5432) — Prisma
# needs a direct connection for `db push`/migrations. If you're on a plain local/direct
# Postgres connection, just set this to the same value as DATABASE_URL.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-long-random-secret"

# Team timezone (IANA tz name)
TEAM_TIMEZONE="Asia/Dhaka"
NEXT_PUBLIC_TEAM_TIMEZONE="Asia/Dhaka"

# Discord Webhooks (server-side only, never exposed to the client)
DISCORD_CHECKIN_WEBHOOK_URL=""
DISCORD_CHECKOUT_WEBHOOK_URL=""
# Optional: notified whenever someone exports the Property Knowledge Base CSV
# (which contains wifi passwords / door codes). Leave blank to disable.
DISCORD_KNOWLEDGE_EXPORT_WEBHOOK_URL=""

# Discord Bot — used for task activity notifications and the daily digest
# (lib/discord-bot.ts), separate from the plain webhooks above because the
# digest needs clickable buttons, which a webhook can't send or receive
# clicks for. Create an Application + Bot at
# https://discord.com/developers/applications, invite it to your server
# with "Send Messages" + "Use Slash Commands" permissions, then:
#   DISCORD_BOT_TOKEN       — Bot tab > Reset Token
#   DISCORD_PUBLIC_KEY      — General Information tab
#   DISCORD_TASK_CHANNEL_ID — right-click the channel in Discord (Developer
#                             Mode on) > Copy Channel ID
# After deploying, also set this app's URL + /api/discord/interactions as
# the Application's "Interactions Endpoint URL" (General Information tab) —
# Discord verifies it with a PING before saving, so it must already be live.
DISCORD_BOT_TOKEN=""
DISCORD_PUBLIC_KEY=""
DISCORD_TASK_CHANNEL_ID=""

# A random secret Vercel Cron sends back as `Authorization: Bearer
# $CRON_SECRET` when it calls /api/cron/daily-digest — without it, nothing
# else can trigger that endpoint. Any long random string.
CRON_SECRET=""

# Google Sheets Knowledge Base sync (lib/google-sheets/). Server-only — never
# exposed to the browser. Without credentials, Google Spreadsheet
# creation/sync fails gracefully (ClientGoogleSheet.status = ERROR with a
# clear message) instead of breaking client/property creation.
#
# Two auth methods — use whichever fits your Google account (see
# lib/google-sheets/client.ts for the full explanation). If both are set,
# OAuth2 takes precedence.

# Method 1 — OAuth2 as a real Google account. Required for a plain Gmail /
# personal Google account, since a real user has normal Drive storage
# quota. Create an OAuth 2.0 Client ID (Desktop app) in Google Cloud
# Console, run a one-time consent flow for the account you want to own the
# spreadsheets, and paste the resulting refresh token here.
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""
GOOGLE_OAUTH_REFRESH_TOKEN=""

# Method 2 — a service account. Only works if GOOGLE_DRIVE_CLIENTS_FOLDER_ID
# below is a folder inside a real Shared Drive (Google Workspace only) with
# the service account added as a member (Content Manager or above) — a bare
# service account has 0 bytes of its own storage quota and becomes the
# owner of anything it creates, so it fails with "storageQuotaExceeded"
# anywhere else, regardless of folder sharing.
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=""

# Optional either way. A Drive folder id new client spreadsheets are created
# in. With OAuth2, any ordinary folder that account can write to works —
# without it, spreadsheets just land in that account's Drive root. With a
# service account, see Method 2 above: it's effectively required.
GOOGLE_DRIVE_CLIENTS_FOLDER_ID=""
