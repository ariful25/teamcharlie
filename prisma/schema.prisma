// Charlie HQ — Module 1.1 schema
// Modular by design: Team-scoped models so Alpha/Bravo/Delta can be added later
// without restructuring Team Charlie's data.
//
// Module 1.1 changes:
// - Removed Routine (was a misnamed recurring-task-template entity).
// - Recurring tasks are now a flag + fields directly on Task (see RepeatMode below).
// - Added ShiftType + ShiftAssignment: the real "weekly roster" the team uses
//   (Morning/Evening/Night/Backup, per-day Working/Weekend/Leave, per-person time
//   overrides) — this is the single source of truth for expected attendance times.

generator client {
  provider        = "prisma-client-js"
  // omitApi: lets lib/prisma.ts hide User.passwordHash from every query by default.
  previewFeatures = ["omitApi"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Supabase (and similar poolers) need a non-pooled direct connection for
  // migrations/`db push` — set DIRECT_URL in .env if your DATABASE_URL points at a
  // pgbouncer/session-pooler port. Safe to leave DIRECT_URL == DATABASE_URL otherwise.
  directUrl = env("DIRECT_URL")
}

// ---------- ENUMS ----------

enum Role {
  ADMIN
  // Sees every team; edits people, attendance, leave and payroll.
  HR
  TEAM_LEAD
  EMPLOYEE
}

enum ClientStatus {
  STABLE
  ATTENTION
  URGENT
  WAITING
}

enum Priority {
  NORMAL
  IMPORTANT
  URGENT
}

enum TaskStatus {
  UPCOMING
  IN_PROGRESS
  COMPLETED
  OVERDUE
  BLOCKED
}

enum RepeatMode {
  NONE
  DAILY
  WEEKLY
  CUSTOM
  MONTHLY
  YEARLY
}

// Only CHECKOUT exists today, but kept as an enum (not a hardcoded string)
// since a check-in or shift-handover checklist is an obvious next step.
enum ChecklistType {
  CHECKOUT
}

// Whether a lead/admin still has to confirm a record (docs/attendance-rules.md).
// NONE = clean punches, counts as-is. PENDING = missed punch / auto-stopped /
// claim waiting. APPROVED = confirmed (effective times). REJECTED = claim not
// accepted / didn't work — only real punches count.
enum AttendanceReview {
  NONE
  PENDING
  APPROVED
  REJECTED
}

enum OvertimeStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum AttendanceStatus {
  ON_TIME
  LATE
  CHECKED_IN
  CHECKED_OUT
  MISSING_CHECK_IN
  MISSING_CHECK_OUT
}

// Sticky-note colors for the team Notice board — a fixed, small palette
// (not free-form hex) so every note reads as an intentional physical-note
// color rather than an arbitrary one.
enum NoticeColor {
  YELLOW
  PINK
  BLUE
  PURPLE
  GREEN
  ORANGE
}

enum ShiftDayStatus {
  WORKING
  WEEKEND
  PAID_LEAVE
  UNPAID_LEAVE
  SICK_LEAVE
}

enum UnitListingLevel {
  WHOLE_PROPERTY
  WHOLE_HOUSE
  PRIVATE_ROOM
  DETACHED_UNIT
}

enum TenancyStatus {
  CURRENT
  UPCOMING
  VACANT
  AIRBNB_TRANSITION
}

enum KnowledgePropertyStatus {
  PENDING
  EXTRACTING
  NEEDS_REVIEW
  READY
  EXPORTED
  FAILED
}

// STANDARD is the generic Tasks/Issues/Knowledge-Base workspace every client
// gets automatically. PERFECT_STAY_LTR opts into the Property/Unit/Tenancy/
// Lead long-term-rental workspace (components/properties/perfect-stay-workspace.tsx).
// This replaces a client.name === "Perfect Stay" string check — renaming a
// client must never change which workspace it gets.
enum ClientWorkspaceTemplate {
  STANDARD
  PERFECT_STAY_LTR
}

// Charlie HQ has no real connector implementation for any of these today —
// this registry tracks capability + manually-recorded connection status
// only (see ClientIntegration), the same way TeamSettings already tracks
// discordCheckinWebhookConfigured as a manual flag rather than a live check.
// No credentials are ever stored against this model.
enum IntegrationProvider {
  GUESTY
  AIRBNB
  CLICKUP
  WHATSAPP
  ENSO
  HOSTBUDDY
  GOOGLE_DRIVE
  GOOGLE_SHEETS
  NOTION
  OTHER
}

enum IntegrationStatus {
  NOT_CONNECTED
  NEEDS_AUTHORIZATION
  CONNECTED
  ERROR
}

enum ClientFileCategory {
  SOP
  PROPERTIES
  INVOICES
  KNOWLEDGE
  OTHER
}

// UPLOAD is reserved for when a binary storage provider (Vercel Blob,
// Supabase Storage, S3, ...) is configured — none is today, so the UI only
// accepts link-based sources. See lib/services/client-files.ts.
enum ClientFileSource {
  UPLOAD
  GOOGLE_DRIVE
  URL
  GENERATED
  EXTERNAL
}

// CREATING is a short-lived transitional state while the Drive/Sheets API
// calls that build the spreadsheet are in flight — a client should never
// stay in it; see lib/google-sheets/spreadsheet.ts.
enum GoogleSheetStatus {
  NOT_CONNECTED
  CREATING
  CONNECTED
  ERROR
}

// SYSTEM columns are the fixed Properties-tab columns Charlie itself writes
// (see lib/google-sheets/columns.ts's SYSTEM_COLUMNS) — sync always updates
// them. CUSTOM columns are anything an admin added directly in the sheet;
// sync discovers and records them here but never writes to or removes them.
enum KnowledgeColumnType {
  SYSTEM
  CUSTOM
}

// ---------- CORE ----------

model Team {
  id                String             @id @default(cuid())
  pushSubscriptions PushSubscription[]
  name              String             @unique // "Charlie"
  slug              String             @unique // "charlie"
  timezone          String             @default("Asia/Dhaka")
  users             User[]
  clients           Client[]
  tasks             Task[]
  notices           Notice[]
  shiftTypes        ShiftType[]
  settings          TeamSettings?
  checklistItems    ChecklistItem[]
  categories        Category[]
  invites           TeamInvite[]
  squads            Squad[]
  lastGeneratedAt   DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
}

// A team inside the company (Alfa, Bravo, Charlie, Delta). The `Team` model
// above is the company itself: the security wall every query is scoped by
// (teamId). A Squad is the working unit inside it: its own people, clients,
// tasks and notices. Admin and HR see all squads; everyone else sees only
// their own (lib/scope.ts).
model Squad {
  id        String   @id @default(cuid())
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  name      String
  active    Boolean  @default(true)
  users     User[]
  clients   Client[]
  tasks     Task[]
  notices   Notice[]
  invites   TeamInvite[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([teamId, name])
}

model TeamSettings {
  id     String @id @default(cuid())
  teamId String @unique
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)

  discordCheckinWebhookConfigured  Boolean @default(false)
  discordCheckoutWebhookConfigured Boolean @default(false)

  // One Discord incoming-webhook URL for every event (tasks, check-in/out,
  // exports) for a team that isn't the deployment's home team — see
  // lib/notifications.ts. Server-side only; never sent to the browser.
  discordWebhookUrl String?

  // A check-in with no check-out is stopped automatically after this many
  // hours (or the scheduled end + approved overtime, if later) and sent for
  // review — see docs/attendance-rules.md.
  autoCheckoutHours Int @default(10)

  // ---- AI (lib/ai) — the team's own keys, encrypted at rest (lib/crypto.ts),
  // never sent back to the browser.
  aiEnabled       Boolean @default(false)
  aiProvider      String  @default("ANTHROPIC") // ANTHROPIC | OPENAI
  anthropicKeyEnc String?
  openaiKeyEnc    String?
  anthropicModel  String?
  openaiModel     String?
  aiDailyLimit    Int     @default(200)

  // ---- Review email sync (lib/listing-health/inbox.ts): a Google Apps Script
  // in the team's Gmail posts Airbnb review emails with this token. Only a
  // SHA-256 hash is stored; the token itself is shown once in Settings.
  reviewInboxTokenHash   String?   @unique
  reviewInboxTokenHint   String?
  reviewInboxCreatedById String?
  reviewInboxLastSeenAt  DateTime?

  // ---- Leave allowances per calendar year (days).
  paidLeavePerYear Int @default(10)
  sickLeavePerYear Int @default(14)

  // ---- Payroll rules (lib/payroll/calc.ts). Defaults follow the team's
  // overtime form: 1.5x normal days, 2x public holidays.
  currency             String @default("BDT")
  otMultiplier         Float  @default(1.5)
  holidayOtMultiplier  Float  @default(2)
  otBase               String @default("BASIC") // BASIC | GROSS
  otHoursPerMonth      Int    @default(208)
  dailyRateDivisor     Int    @default(30)
  // Every N late days deducts one day's pay; 0 = off.
  lateDaysPerDeduction Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// A team-editable set of prompts shown before an employee can confirm a
// checkout (see components/dashboard/checkout-checklist-dialog.tsx). Items
// are freely added/edited/deleted; what was actually shown and checked at
// a given checkout is snapshotted onto AttendanceRecord.checkoutChecklist
// (Json) rather than referenced live, so editing the list later never
// rewrites history.
model ChecklistItem {
  id     String        @id @default(cuid())
  teamId String
  team   Team          @relation(fields: [teamId], references: [id])
  type   ChecklistType @default(CHECKOUT)
  label  String
  order  Int           @default(0)
  active Boolean       @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([teamId, type, active])
}

model User {
  id                String             @id @default(cuid())
  name              String
  email             String             @unique
  pushSubscriptions PushSubscription[]
  passwordHash      String
  avatarUrl         String?
  role              Role               @default(EMPLOYEE)
  teamId            String
  team              Team               @relation(fields: [teamId], references: [id])
  // Null only for company-wide roles (Admin, HR). Everyone else works in one team.
  squadId           String?
  squad             Squad?             @relation(fields: [squadId], references: [id])
  active            Boolean            @default(true)

  // Their Discord user ID (an 18-ish digit snowflake, not a username) — set
  // in Settings so the bot can @mention the right person in task/digest
  // messages. Null until an admin fills it in; notifications fall back to
  // plain name text when it's missing.
  discordUserId String?
  // Same idea for Slack — a Slack member ID (e.g. "U0123456789"), not a
  // username/handle.
  slackUserId   String?

  defaultShiftTypeId String?
  defaultShiftType   ShiftType? @relation("UserDefaultShift", fields: [defaultShiftTypeId], references: [id])

  assignedTasks     Task[]             @relation("TaskAssignee")
  attendanceRecords AttendanceRecord[]
  overtimeRequests  OvertimeRequest[]  @relation("OvertimeRequests")
  leaveRequests     LeaveRequest[]     @relation("LeaveRequests")
  salary            EmployeeSalary?

  profile           EmployeeProfile?   @relation("ProfileOf")
  directReports     EmployeeProfile[]  @relation("ManagerOf")
  emergencyContacts EmergencyContact[]
  documents         EmployeeDocument[] @relation("DocumentsOf")
  peopleEvents      EmployeeEvent[]    @relation("EventsOf")
  payrollLines      PayrollLine[]
  postedNotices     Notice[]           @relation("NoticeAuthor")
  shiftAssignments  ShiftAssignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([teamId])
  @@index([squadId])
}

model Client {
  id                          String                  @id @default(cuid())
  name                        String
  status                      ClientStatus            @default(STABLE)
  guestCommunicationPlatform  String?
  operationPlatform           String?
  clientCommunicationPlatform String?
  notes                       String?
  active                      Boolean                 @default(true)
  // Every client gets STANDARD automatically — this is what makes a new
  // client's workspace fully functional without any code change. Only an
  // explicit admin action moves a client onto a specialized template.
  workspaceTemplate           ClientWorkspaceTemplate @default(STANDARD)
  teamId                      String
  team                        Team                    @relation(fields: [teamId], references: [id])
  squadId                     String?
  squad                       Squad?                  @relation(fields: [squadId], references: [id])

  tasks             Task[]
  properties        Property[]
  leads             Lead[]
  knowledgeItems    PropertyKnowledgeItem[]
  integrations      ClientIntegration[]
  files             ClientFile[]
  googleSheet       ClientGoogleSheet?
  knowledgeColumns  KnowledgeColumn[]
  knowledgeSyncLogs KnowledgeSyncLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([teamId])
  @@index([squadId])
}

// Capability/connection-status registry for a client's external
// integrations. Deliberately holds no credentials/tokens — status is
// recorded the same way TeamSettings.discordCheckinWebhookConfigured is:
// a manually-set fact, not a live-verified one, because Charlie HQ has no
// real OAuth/API connector for any of these providers yet.
model ClientIntegration {
  id       String @id @default(cuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  provider IntegrationProvider
  status   IntegrationStatus   @default(NOT_CONNECTED)
  note     String?

  connectedAt   DateTime?
  lastCheckedAt DateTime?
  lastError     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([clientId, provider])
  @@index([clientId])
}

// A client-scoped document/link reference. Every source today is a link
// (GOOGLE_DRIVE/URL/GENERATED/EXTERNAL) — see the ClientFileSource comment
// for why raw UPLOAD bytes aren't wired up yet.
model ClientFile {
  id       String @id @default(cuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  name     String
  category ClientFileCategory @default(OTHER)
  source   ClientFileSource
  url      String

  // Plain id, not a relation — matches the existing audit-trail convention
  // (AttendanceRecord.editedBy, Task.completedBy) elsewhere in this schema.
  createdById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@index([clientId, category])
}

// One spreadsheet per client (see lib/google-sheets/spreadsheet.ts). No
// credentials live here — only the file's own id/url and sync bookkeeping.
// @@unique(clientId) enforces the "one spreadsheet per client" rule at the
// database level, not just in application logic.
model ClientGoogleSheet {
  id       String @id @default(cuid())
  clientId String @unique
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  spreadsheetId  String?
  spreadsheetUrl String?
  status         GoogleSheetStatus @default(NOT_CONNECTED)

  lastSyncedAt  DateTime?
  lastSyncError String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// A DB-side cache of the column registry that actually lives in each
// spreadsheet's hidden _CharlieConfig sheet (see lib/google-sheets/columns.ts).
// The sheet itself is always the source of truth for sync decisions; this
// table exists so Charlie's own UI can list a client's custom columns
// without an extra Sheets API round-trip on every page load.
model KnowledgeColumn {
  id       String @id @default(cuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  columnName String
  columnType KnowledgeColumnType
  // Free-text provenance ("CHARLIE" for a system column, "ADMIN" for a
  // custom column discovered in the sheet) — not a relation, since a custom
  // column isn't tied to the specific user who happened to add it.
  source     String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([clientId, columnName])
  @@index([clientId])
}

// Backs both the sheet's own "Change Log" tab and the "View Sync Log"
// button in the client workspace — every sync-related event is written
// here first, then mirrored into the spreadsheet, so the panel never needs
// a Sheets API call just to show recent activity.
model KnowledgeSyncLog {
  id       String @id @default(cuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  propertyId String?
  property   PropertyKnowledgeItem? @relation(fields: [propertyId], references: [id], onDelete: SetNull)

  action   String // SPREADSHEET_CREATED | FIELD_UPDATED | PROPERTY_ADDED | SYNC_ERROR | ...
  field    String?
  oldValue String?
  newValue String?
  source   String // AIRBNB_EXTRACTION | MANUAL_EDIT | BULK_IMPORT | SYSTEM
  message  String?

  createdAt DateTime @default(now())

  @@index([clientId, createdAt])
  @@index([propertyId])
}

// Per team — each team gets its own copy of the default list on sign-up
// (lib/services/team-onboarding.ts). Was global before multi-team, which
// would have shown one team's custom categories to every other team.
model Category {
  id       String  @id @default(cuid())
  name     String
  isCustom Boolean @default(false)
  tasks    Task[]

  teamId String
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([teamId, name])
}

// A single-use link an admin sends to bring someone onto their team. The raw
// token is only ever in the link itself; the database stores its SHA-256.
model TeamInvite {
  id         String    @id @default(cuid())
  teamId     String
  team       Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  email      String
  // Filled in by whoever added them, so the join page is already personal.
  name       String?
  role       Role      @default(EMPLOYEE)
  squadId    String?
  squad      Squad?    @relation(fields: [squadId], references: [id])
  tokenHash  String    @unique
  expiresAt  DateTime
  acceptedAt DateTime?
  revokedAt  DateTime?
  createdBy  String
  createdAt  DateTime  @default(now())

  @@index([teamId])
  @@index([email])
}

// A Task can optionally be a recurring template (isRecurringTemplate: true).
// Recurrence lives directly on the Task row — there is no separate template entity.
// lib/services/task-generation.ts reads repeatMode/repeatDays on template tasks and
// spawns plain (non-template) Task rows for future days.
model Task {
  id           String  @id @default(cuid())
  clientId     String?
  client       Client? @relation(fields: [clientId], references: [id])
  propertyName String?

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  assignedUserId String?
  assignedUser   User?   @relation("TaskAssignee", fields: [assignedUserId], references: [id])

  // Ties a recurring template to a shift role (Morning/Evening/...) instead
  // of one fixed person — whoever's actually scheduled on ShiftAssignment
  // for that shift on the day an instance is generated gets assignedUserId
  // set automatically (see generateRecurringTaskInstances). Null means a
  // normal task: a fixed assignee (or none), same as before this existed.
  shiftTypeId String?
  shiftType   ShiftType? @relation(fields: [shiftTypeId], references: [id])

  // Set on a generated instance, pointing back at the recurring template it
  // came from — lets editing an instance offer "also apply to future
  // occurrences" without guessing which template it matches (the old
  // approach fuzzy-matched on title/client/assignee, which breaks the
  // moment either is edited). Null on a one-off task, and on the template
  // row itself (a template is never another template's instance).
  recurringTemplateId String?
  recurringTemplate   Task?   @relation("TaskRecurrence", fields: [recurringTemplateId], references: [id])
  recurringInstances  Task[]  @relation("TaskRecurrence")

  title       String
  description String?
  // Free-text notes, editable via TaskDetailDialog's edit mode.
  notes       String?

  date      DateTime // calendar day (UTC midnight) this task instance belongs to
  startTime String? // "HH:mm"
  dueTime   String? // "HH:mm"

  priority Priority   @default(NORMAL)
  status   TaskStatus @default(UPCOMING)

  completedAt   DateTime?
  completedBy   String?
  blockedReason String?

  // Recurrence (folded in, no separate Routine entity)
  isRecurringTemplate Boolean    @default(false)
  repeatMode          RepeatMode @default(NONE)
  repeatDays          Int[]      @default([]) // 0=Sunday .. 6=Saturday, used for WEEKLY/CUSTOM
  // Day of month (1-31) for MONTHLY, clamped to the actual length of each
  // generated month (e.g. 31 clamps to Feb 28/29) — null falls back to the
  // day-of-month of this template's own `date`. YEARLY instead reuses
  // `date`'s month+day directly, so it needs no field of its own.
  repeatDayOfMonth    Int?

  teamId String
  team   Team   @relation(fields: [teamId], references: [id])
  // The team the task belongs to: its client's team, else the assignee's.
  squadId String?
  squad   Squad? @relation(fields: [squadId], references: [id])

  // Soft delete — a task with an audit trail (completedAt/completedBy) must
  // not be destroyable without a trace. Every read query filters
  // `deletedAt: null`; "deleting" a task sets this instead of removing the
  // row, and it can be restored by clearing it again.
  deletedAt DateTime?
  deletedBy String?

  // Where an auto-created task came from, e.g. "lh:<propertyId>:CATEGORY_VALUE"
  // (Listing Health fix-it task) — used to avoid creating it twice.
  sourceRef String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Belt-and-suspenders against the generator ever creating two instances of
  // the same template on the same day (e.g. a throttle race between two
  // concurrent requests) — Postgres treats NULL as distinct from NULL, so
  // this only constrains actual generated instances, never one-off tasks.
  @@unique([recurringTemplateId, date])
  @@index([teamId, sourceRef])
  @@index([teamId, date])
  @@index([clientId])
  @@index([assignedUserId])
  @@index([status])
  @@index([isRecurringTemplate])
  @@index([teamId, deletedAt])
  @@index([recurringTemplateId])
  @@index([teamId, squadId])
}

model Property {
  id             String   @id @default(cuid())
  clientId       String
  client         Client   @relation(fields: [clientId], references: [id])
  internalCode   String
  address        String
  city           String
  state          String
  zip            String?
  photosLink     String?
  redfinLink     String?
  zillowLink     String?
  googleMapsLink String?
  driveTimesNote String?
  generalNotes   String?
  active         Boolean  @default(true)
  units          Unit[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([clientId, internalCode])
  @@index([clientId])
}

model PropertyKnowledgeItem {
  id       String @id @default(cuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id])

  internalName    String
  airbnbUrl       String
  airbnbListingId String?

  status          KnowledgePropertyStatus @default(PENDING)
  completionPct   Int                     @default(0)
  extractionError String?

  listingName   String?
  description   String?
  amenities     String[] @default([])
  propertyType  String?
  location      String?
  guestCapacity Int?
  bedrooms      Float?
  bathrooms     Float?
  beds          Float?
  rules         String?

  wifiName      String?
  wifiPassword  String?
  doorCode      String?
  parkingInfo   String?
  checkInInfo   String?
  checkoutInfo  String?
  internalNotes String?

  extractedAt         DateTime?
  exportedAt          DateTime?
  // Set every time this row is written to the client's Google Sheet — not
  // the same as exportedAt (which tracks the CSV export instead). Null
  // means it has never been synced (e.g. the client has no spreadsheet, or
  // this property was created before one existed).
  googleSheetSyncedAt DateTime?

  syncLogs        KnowledgeSyncLog[]
  healthSnapshots ListingHealthSnapshot[]
  reviews         ListingReview[]
  aiNotes         ListingAiNote[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stays GuestStay[]

  @@unique([clientId, airbnbUrl])
  @@index([clientId])
  @@index([clientId, status])
  @@index([clientId, createdAt])
}

model Unit {
  id                 String           @id @default(cuid())
  propertyId         String
  property           Property         @relation(fields: [propertyId], references: [id])
  parentUnitId       String?
  parentUnit         Unit?            @relation("UnitHierarchy", fields: [parentUnitId], references: [id])
  childUnits         Unit[]           @relation("UnitHierarchy")
  internalName       String
  listingLevel       UnitListingLevel
  bedBathConfig      String?
  bedType            String?
  hasSofaBed         Boolean          @default(false)
  thermostatLocation String?
  parkingInfo        String?
  petPolicy          String?
  hasTV              Boolean?
  airbnbLink         String?
  vrboLink           String?
  amenitiesDocLink   String?
  active             Boolean          @default(true)
  tenancies          Tenancy[]
  leads              Lead[]
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([propertyId])
  @@index([parentUnitId])
}

model Tenancy {
  id                String        @id @default(cuid())
  unitId            String
  unit              Unit          @relation(fields: [unitId], references: [id])
  status            TenancyStatus
  tenantName        String?
  tenantContact     String?
  moveInDate        DateTime?
  moveOutDate       DateTime?
  nextTenantName    String?
  nextTenantMoveIn  DateTime?
  nextTenantMoveOut DateTime?
  leaseSource       String?
  rentAmount        Decimal?      @db.Decimal(10, 2)
  securityDeposit   Decimal?      @db.Decimal(10, 2)
  cleaningFee       Decimal?      @db.Decimal(10, 2)
  petFee            Decimal?      @db.Decimal(10, 2)
  utilitiesNote     String?
  parkingNote       String?
  amountDue         Decimal?      @db.Decimal(10, 2)
  notes             String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([unitId])
  @@index([status])
}

model Lead {
  id               String    @id @default(cuid())
  clientId         String
  client           Client    @relation(fields: [clientId], references: [id])
  interestedUnitId String?
  interestedUnit   Unit?     @relation(fields: [interestedUnitId], references: [id])
  name             String
  channel          String
  status           String
  contactedDate    DateTime?
  notes            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([clientId])
  @@index([interestedUnitId])
}

// The four (or more) shift blocks the team schedules against. Admin-editable in
// Settings — never hardcoded in application code.
model ShiftType {
  id        String  @id @default(cuid())
  teamId    String
  team      Team    @relation(fields: [teamId], references: [id])
  name      String // "Morning", "Evening", "Night", "Backup"
  startTime String // "HH:mm"
  endTime   String // "HH:mm" — may be earlier than startTime (crosses midnight)
  colorHex  String  @default("#22d3ee")
  active    Boolean @default(true)

  assignments     ShiftAssignment[]
  tasks           Task[]
  defaultForUsers User[]            @relation("UserDefaultShift")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([teamId, name])
}

// The real weekly roster: one row per employee per specific calendar day.
// This is the single source of truth for "who is expected to work when" — the
// Attendance check-in/check-out flow reads scheduled times from here.
model ShiftAssignment {
  id          String         @id @default(cuid())
  userId      String
  user        User           @relation(fields: [userId], references: [id])
  date        DateTime // specific calendar day (UTC midnight)
  shiftTypeId String?
  shiftType   ShiftType?     @relation(fields: [shiftTypeId], references: [id])
  status      ShiftDayStatus @default(WORKING)
  customStart String? // "HH:mm" override, e.g. this person's Evening actually runs 3PM-12AM
  customEnd   String? // "HH:mm" override
  note        String? // free text, mirrors the spreadsheet's NOTE column

  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
  @@index([date])
}

model AttendanceRecord {
  id     String   @id @default(cuid())
  userId String
  user   User     @relation(fields: [userId], references: [id])
  date   DateTime // calendar day (UTC midnight)

  scheduledCheckIn  String?
  scheduledCheckOut String?
  // Absolute scheduled instants (end is on the next day for overnight
  // shifts). Null for an unscheduled day.
  shiftStartAt      DateTime?
  shiftEndAt        DateTime?

  // Raw punches — server time, never overwritten by an edit or approval.
  actualCheckIn  DateTime?
  actualCheckOut DateTime?

  // System marker: the open session was stopped here because nobody checked
  // out (docs/attendance-rules.md, rule 4). actualCheckOut stays null.
  autoClosedAt       DateTime?
  // Employee pressed "Confirm check-out" after the auto-stop.
  reportedCheckOutAt DateTime?
  // Employee was blocked by an unresolved shift and asked to start this one.
  checkInRequestedAt DateTime?
  // Employee's claimed real times for a missed punch.
  claimedCheckIn     DateTime?
  claimedCheckOut    DateTime?
  claimReason        String?
  missedCheckIn      Boolean   @default(false)
  missedCheckOut     Boolean   @default(false)
  // Set by the auto-stop: this unresolved shift locks the employee's next
  // check-in until a lead confirms it. Records imported from before these
  // rules are queued for review but never lock anyone out.
  blocksCheckIn      Boolean   @default(false)

  // What a lead/admin confirmed — used for hours instead of the punches.
  effectiveCheckIn   DateTime?
  effectiveCheckOut  DateTime?
  review             AttendanceReview @default(NONE)
  reviewedBy         String?
  reviewedAt         DateTime?
  reviewNote         String?
  tasksConfirmed     Boolean          @default(false)
  checkoutNotifiedAt DateTime?

  totalMinutes Int?
  lateMinutes  Int?

  status AttendanceStatus @default(MISSING_CHECK_IN)

  // Snapshot of the active ChecklistItem labels and their checked state at
  // the moment of this checkout — e.g. [{"id":"...","label":"...","checked":true}].
  // Deliberately not a relation: editing or deleting a ChecklistItem later
  // must never rewrite what was actually shown/confirmed on a past checkout.
  checkoutChecklist Json?

  discordCheckInSynced  Boolean @default(false)
  discordCheckOutSynced Boolean @default(false)
  discordCheckInError   String?
  discordCheckOutError  String?

  slackCheckInSynced  Boolean @default(false)
  slackCheckOutSynced Boolean @default(false)
  slackCheckInError   String?
  slackCheckOutError  String?

  editedBy   String?
  editedAt   DateTime?
  editReason String?

  audits AttendanceAudit[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
  @@index([date])
  @@index([review])
}

// Who changed what on an attendance record, and why. Append-only.
model AttendanceAudit {
  id        String           @id @default(cuid())
  recordId  String
  record    AttendanceRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)
  actorId   String
  action    String // APPROVE, REJECT, ABSENT, CLAIM, AUTO_STOP, CONFIRM_CHECKOUT, REQUEST_CHECK_IN
  before    Json?
  after     Json?
  note      String?
  createdAt DateTime         @default(now())

  @@index([recordId])
}

// Overtime only counts when approved here first (docs/attendance-rules.md,
// rule 7) — never inferred from a late check-out.
model OvertimeRequest {
  id                  String         @id @default(cuid())
  teamId              String
  userId              String
  user                User           @relation("OvertimeRequests", fields: [userId], references: [id])
  date                DateTime // shift day (UTC midnight), same key as AttendanceRecord.date
  requestedMinutes    Int
  reason              String
  // The lead/admin who asked for the overtime (the old form's "Requested by").
  askedById           String?
  publicHoliday       Boolean        @default(false)
  submittedAfterShift Boolean        @default(false)
  status              OvertimeStatus @default(PENDING)
  approvedMinutes     Int?
  reviewedById        String?
  reviewedAt          DateTime?
  reviewNote          String?
  createdById         String
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  @@index([teamId, status])
  @@index([userId, date])
}

// A team-wide bulletin board — simple sticky notes, not a ticket/workflow
// system (that's what Tasks is for). Deliberately no client/unit scoping,
// no status, no severity: anyone on the team can pin up a reminder or tip,
// see components/notices/notice-board.tsx.
model Notice {
  id        String      @id @default(cuid())
  // Empty string for a checklist note with no caption — see the `checklist`
  // comment below. Never empty for a plain text note (enforced by
  // noticeSchema in lib/validations.ts, not the DB).
  content   String
  color     NoticeColor @default(YELLOW)
  // Pinned notices always sort first — for a genuine announcement over a
  // casual sticky note. See lib/auth.ts's canPinNotices for who can pin.
  pinned    Boolean     @default(false)
  // Archived notices drop off the main board but aren't deleted — the
  // Google-Keep-style "clean up without losing it" action. Distinct from
  // delete, which is permanent.
  archived  Boolean     @default(false)
  // Null for a plain text note. A JSON array of {id, text, checked} for a
  // checklist note — Prisma has no native list-of-objects column, and a
  // separate NoticeChecklistItem table would be overkill for a handful of
  // items per note that are only ever replaced as a whole array (see the
  // PATCH /api/notices/[id] comment on why toggling doesn't need row-level
  // granularity).
  checklist Json?

  authorId String
  author   User   @relation("NoticeAuthor", fields: [authorId], references: [id])

  teamId String
  team   Team   @relation(fields: [teamId], references: [id])
  // Null is a company-wide notice (posted by Admin or HR).
  squadId String?
  squad   Squad? @relation(fields: [squadId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([teamId, archived, pinned, createdAt])
  @@index([squadId])
}

// ---- Listing Health (lib/listing-health) ----

// One public-page check of a knowledge-base listing. Kept as history (not
// overwritten) so rating and health trends are visible over time.
model ListingHealthSnapshot {
  id         String                @id @default(cuid())
  propertyId String
  property   PropertyKnowledgeItem @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  fetchedAt  DateTime              @default(now())
  // false = the listing page couldn't be read (delisted, snoozed, blocked).
  ok         Boolean
  error      String?

  title             String?
  rating            Float?
  reviewCount       Int?
  cleanliness       Float?
  accuracy          Float?
  checkin           Float?
  communication     Float?
  location          Float?
  value             Float?
  // Share of reviews per star, e.g. {"5":0.74,"4":0.18,"3":0.05,"2":0.03,"1":0}.
  starShares        Json?
  // Airbnb's own review themes, e.g. [{"name":"Location","count":32}].
  reviewTags        Json?
  guestFavorite     Boolean  @default(false)
  superhost         Boolean  @default(false)
  photoCount        Int?
  genericCaptions   Int?
  descriptionLength Int?
  amenities         String[] @default([])

  healthScore  Int?
  qualityScore Int?
  // Set when the weekly check sent an alert about this snapshot.
  alertSentAt  DateTime?
  // [{code, severity, title, detail, action}] — see lib/listing-health/score.ts
  issues       Json?

  @@index([propertyId, fetchedAt])
}

// A guest review imported from a CSV export (PMS/Guesty) or added by hand.
// Airbnb's public page doesn't include review texts, so this is the source
// for "what's wrong" analysis and the 1–4 star lists.
model ListingReview {
  id          String                @id @default(cuid())
  propertyId  String
  property    PropertyKnowledgeItem @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  source      String // IMPORT | MANUAL
  reviewDate  DateTime?
  rating      Int // 1–5
  guestName   String?
  comment     String
  privateNote String?
  // Duplicate guard for re-imports: hash of date + rating + comment.
  fingerprint String
  // The stay this review belongs to (review pipeline), and when the team
  // posted its public response on Airbnb.
  stayId      String?
  respondedAt DateTime?
  createdById String
  createdAt   DateTime              @default(now())

  @@unique([propertyId, fingerprint])
  @@index([propertyId, rating])
}

// ---- AI (lib/ai) ----

// Every AI call, for cost visibility and the per-team daily limit.
model AiUsage {
  id           String   @id @default(cuid())
  teamId       String
  userId       String
  feature      String
  provider     String
  model        String
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  ok           Boolean
  error        String?
  createdAt    DateTime @default(now())

  @@index([teamId, createdAt])
}

// Saved AI output for a listing (insights, check-in guide, copy ideas, a
// review reply) so it isn't regenerated — and paid for — on every page view.
model ListingAiNote {
  id          String                @id @default(cuid())
  propertyId  String
  property    PropertyKnowledgeItem @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  kind        String // INSIGHTS | CHECKIN_GUIDE | COPY | REVIEW_REPLY
  reviewId    String?
  content     Json
  provider    String
  model       String
  createdById String
  createdAt   DateTime              @default(now())

  @@index([propertyId, kind, createdAt])
}

// ---- Leave ----

enum LeaveType {
  PAID
  UNPAID
  SICK
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model LeaveRequest {
  id           String      @id @default(cuid())
  teamId       String
  userId       String
  user         User        @relation("LeaveRequests", fields: [userId], references: [id])
  type         LeaveType
  startDate    DateTime // calendar days (UTC midnight), inclusive
  endDate      DateTime
  days         Int
  reason       String
  status       LeaveStatus @default(PENDING)
  reviewedById String?
  reviewedAt   DateTime?
  reviewNote   String?
  // What the schedule said for each day before approval, so revoking the
  // leave restores it exactly: [{date, existed, status, shiftTypeId, customStart, customEnd}].
  replaced     Json?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([teamId, status])
  @@index([userId, startDate])
}

// ---- Payroll (lib/payroll) ----

model EmployeeSalary {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id])
  // Whole currency units (e.g. taka) per month.
  monthlyGross Int
  basicPercent Int      @default(60)
  updatedById  String
  updatedAt    DateTime @updatedAt
  createdAt    DateTime @default(now())
}

enum PayrollStatus {
  DRAFT
  FINALIZED
}

// A month's payroll. While DRAFT it is recalculated on view; FINALIZED
// freezes the lines below so later attendance edits never change paid pay.
model PayrollRun {
  id          String        @id @default(cuid())
  teamId      String
  year        Int
  month       Int // 0–11
  status      PayrollStatus @default(DRAFT)
  finalizedBy String?
  finalizedAt DateTime?
  lines       PayrollLine[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@unique([teamId, year, month])
}

model PayrollLine {
  id         String     @id @default(cuid())
  runId      String
  run        PayrollRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  userId     String
  user       User       @relation(fields: [userId], references: [id])
  gross      Int
  basic      Int
  otPay      Int
  deductions Int
  adjustment Int        @default(0)
  net        Int
  // Full breakdown (hours, days, rates, notes) — see PayrollBreakdown.
  details    Json

  @@unique([runId, userId])
}

// ---- People: employee profiles ------------------------------------------
// One profile per user. Job fields are admin-edited and every change is
// logged as an EmployeeEvent; contact/personal fields can also be edited by
// the person themselves. Personal fields are visible to the person and
// admins only (lib/people/access.ts).

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERN
}

enum WorkLocation {
  REMOTE
  OFFICE
  HYBRID
}

enum EmployeeEventKind {
  JOINED
  JOB_CHANGE
  PRAISE
  NOTE
  WARNING
}

model EmployeeProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation("ProfileOf", fields: [userId], references: [id])

  // Job
  employeeCode     String?
  jobTitle         String?
  department       String?
  managerId        String?
  manager          User?          @relation("ManagerOf", fields: [managerId], references: [id])
  employmentType   EmploymentType @default(FULL_TIME)
  workLocation     WorkLocation   @default(REMOTE)
  startDate        DateTime? // calendar day (UTC midnight)
  probationEndDate DateTime?

  // About (visible to the team)
  preferredName String?
  bio           String?
  skills        String[] @default([])
  languages     String[] @default([])
  phone         String?
  whatsapp      String?

  // Personal (the person + admins)
  personalEmail String?
  dateOfBirth   DateTime?
  address       String?
  bloodGroup    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([managerId])
}

model EmergencyContact {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  name         String
  relationship String
  phone        String
  createdAt    DateTime @default(now())

  @@index([userId])
}

// Links to files kept elsewhere (Google Drive etc.) — TeamHQ stores no files.
model EmployeeDocument {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation("DocumentsOf", fields: [userId], references: [id])
  title     String
  kind      String // "Contract", "ID", "Certificate", "Policy", "Other"
  url       String
  expiresAt DateTime?
  addedById String
  createdAt DateTime  @default(now())

  @@index([userId])
}

model EmployeeEvent {
  id        String            @id @default(cuid())
  teamId    String
  userId    String
  user      User              @relation("EventsOf", fields: [userId], references: [id])
  kind      EmployeeEventKind
  title     String
  detail    String?
  // Job changes: [{field, from, to}]
  changes   Json?
  // Notes and warnings are admin-only; praise and job history are visible to the person.
  private   Boolean           @default(false)
  actorId   String
  createdAt DateTime          @default(now())

  @@index([userId, createdAt])
  @@index([teamId])
}

// An Airbnb review email received by the review email sync. Read
// automatically when possible (status SAVED, reviewId set); otherwise it
// waits as NEEDS_REVIEW for a person to fill in what the email didn't say.
model ReviewInboxItem {
  id          String   @id @default(cuid())
  teamId      String
  externalId  String // Gmail message id — duplicate guard
  subject     String
  fromAddress String
  receivedAt  DateTime
  body        String
  status      String // SAVED | NEEDS_REVIEW | IGNORED
  // GUEST_REVIEW | CHECKOUT | CONFIRMED | ALTERED | CANCELLED | OTHER
  kind        String   @default("GUEST_REVIEW")
  stayId      String?
  propertyId  String?
  reviewId    String?
  // What the reader found: { guestName, rating, comment, listingRef }
  parsed      Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([teamId, externalId])
  @@index([teamId, status])
}

// ---- Review pipeline (lib/reviews) ---------------------------------------
// One row per Airbnb reservation, built from Airbnb's emails (confirmed,
// altered, cancelled, "write a review for…", "… left a review"). Guest
// message emails are never ingested. Stages:
// BOOKED → CHECKED_OUT → FOLLOW_UP_SENT → (ISSUE) → REVIEW_REQUESTED →
// REVIEWED, or CANCELLED / EXPIRED (14-day review window passed).
model GuestStay {
  id                String                 @id @default(cuid())
  teamId            String
  propertyId        String?
  property          PropertyKnowledgeItem? @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  confirmationCode  String?
  guestName         String
  guests            Int?
  checkIn           DateTime? // calendar day (UTC midnight)
  checkOut          DateTime?
  stage             String                 @default("BOOKED")
  issueNote         String?
  followUpSentAt    DateTime?
  guestRepliedAt    DateTime?
  reviewRequestedAt DateTime?
  hostReviewedAt    DateTime?
  guestReviewedAt   DateTime?
  rating            Int?
  reviewId          String?
  events            StayEvent[]
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  @@unique([teamId, confirmationCode])
  @@index([teamId, stage])
  @@index([teamId, checkOut])
}

model StayEvent {
  id      String    @id @default(cuid())
  stayId  String
  stay    GuestStay @relation(fields: [stayId], references: [id], onDelete: Cascade)
  kind    String // BOOKED, ALTERED, CANCELLED, CHECKED_OUT, FOLLOW_UP_SENT, HAPPY, ISSUE, REVIEW_REQUESTED, HOST_REVIEWED, REVIEWED, EXPIRED, NOTE
  detail  String?
  actorId String?
  at      DateTime  @default(now())

  @@index([stayId, at])
}

// Guest message templates for the pipeline, editable per team. Defaults
// live in lib/reviews/templates.ts and are used until a team edits one.
model MessageTemplate {
  id        String   @id @default(cuid())
  teamId    String
  key       String // FOLLOW_UP | REVIEW_REQUEST | ISSUE_RECOVERY | THANK_YOU
  body      String
  updatedAt DateTime @updatedAt

  @@unique([teamId, key])
}

// Rate-limit counters shared by every server instance (lib/rate-limit.ts).
// In-memory counters don't work on serverless: each instance has its own.
model RateLimit {
  key        String   @id
  count      Int
  windowEnds DateTime
}

// One row per phone/browser that allowed notifications (Web Push). The
// endpoint is the push service's address for that device; p256dh and auth
// encrypt the payload so only that device can read it. Rows are deleted when
// the push service says the device has gone (404/410) or on sign-out.
model PushSubscription {
  id         String    @id @default(cuid())
  teamId     String
  team       Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint   String    @unique
  p256dh     String
  auth       String
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?

  @@index([teamId, userId])
}
